<Project>
  <!-- Version comes from src/web/package.json, so `npm version` bumps the npm and NuGet packages together -->
  <PropertyGroup>
    <_SlickPackageJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)src/web/package.json'))</_SlickPackageJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_SlickPackageJson), '(?&lt;=\x22version\x22\s*:\s*\x22)[^\x22]+'))</Version>
  </PropertyGroup>

  <!-- NuGet metadata. Library projects opt in with IsPackable -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Slick Quant LLC.</Authors>
    <Company>Slick Quant LLC.</Company>
    <Copyright>Copyright (c) 2026 Slick Quant LLC.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SlickQuant/slick-ladder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SlickQuant/slick-ladder</RepositoryUrl>
    <PackageTags>price-ladder;depth-of-market;dom;order-book;trading;market-data</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Source Link (built into the .NET 8 SDK) plus a .snupkg symbol package -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Items are evaluated after every property, so this sees the project's IsPackable -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
